# Base URL the SPA uses to reach the API. In production this should be a
# relative path (served by the same nginx) or your real https origin.
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Maximum upload size the UI will accept (MB). Must not exceed the backend's
# MAX_FILE_SIZE_MB; the client prints a friendly error if it does.
VITE_MAX_FILE_SIZE_MB=10