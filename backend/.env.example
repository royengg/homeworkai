# --- Application -------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeworkai?schema=public

# --- Auth --------------------------------------------------------------------
# Must be at least 32 characters in production.
JWT_SECRET=replace_with_strong_secret_min_32_chars

# --- Cache / Queue -----------------------------------------------------------
# Required in production; falls back to in-memory in dev.
REDIS_URL=redis://127.0.0.1:6379

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Uploads -----------------------------------------------------------------
MAX_FILE_SIZE_MB=10

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# --- Object storage (R2 / S3 / MinIO) ---------------------------------------
STORAGE_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<your-r2-access-key-id>
STORAGE_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
STORAGE_BUCKET=<your-r2-bucket-name>

# --- AI -----------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key

# --- Deployment --------------------------------------------------------------
# Number of reverse-proxy hops between the public internet and this process.
# Set to 1 behind nginx + a single load balancer; 2 if you also front with
# Cloudflare. Wrong value = rate-limit IP spoofing.
TRUST_PROXY_HOPS=1