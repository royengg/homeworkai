# Normalize all text files to LF in the repo regardless of OS checkout.
# Git converts to the native OS line ending on checkout only when the file is
# marked as text — this setting keeps committed blobs as LF, eliminating the
# CRLF/LF phantom "modified" flags that appear on Windows after a checkout.
* text=auto eol=lf

# Explicitly mark binary file types so renormalize never corrupts them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.docx binary
*.doc  binary
*.xlsx binary
*.xls  binary
*.zip  binary